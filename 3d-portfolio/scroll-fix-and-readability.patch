diff --git a/3d-portfolio/src/main.jsx b/3d-portfolio/src/main.jsx
index 833c97f..9c1f9d4 100644
--- a/3d-portfolio/src/main.jsx
+++ b/3d-portfolio/src/main.jsx
@@ -1,10 +1,20 @@
-import { StrictMode } from 'react';
 import { createRoot } from 'react-dom/client';
 import App from './App.jsx';
 import './index.css';
 
-createRoot(document.getElementById('root')).render(
-  <StrictMode>
-    <App />
-  </StrictMode>,
-);
+// NOTE: intentionally not wrapped in <StrictMode>.
+// @react-three/drei's <ScrollControls><Scroll html> internally does
+// `useMemo(() => ReactDOM.createRoot(state.fixed), [state.fixed])` to mount
+// the HTML layer into its own nested React root. StrictMode double-invokes
+// useMemo initializers on mount in dev, which calls createRoot() twice on
+// the same DOM node. React logs "you are calling createRoot() on a
+// container that has already been passed to createRoot()" and the scroll
+// transform stops being applied to the live tree — the page scrolls
+// internally (the HUD progress bar / index counter updates) but the 3D
+// scene and HTML sections visually never move. This is a known
+// drei/StrictMode incompatibility, not a bug in this app's own code — see
+// https://github.com/pmndrs/react-three-a11y/issues/52 for the same root
+// cause in a sibling package. Do not re-add StrictMode around <App /> (or
+// around anything containing the Canvas) without also patching
+// ScrollControls to guard against a double createRoot() call.
+createRoot(document.getElementById('root')).render(<App />);
